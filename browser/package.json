{
  "name": "terminal-browser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "agent:cross-origin-smoke": "node scripts/agent-cross-origin-smoke.cjs",
    "agent:evaluation-smoke": "node scripts/agent-evaluation-smoke.cjs",
    "agent:frame-smoke": "node scripts/agent-frame-smoke.cjs",
    "agent:reconnect-smoke": "node scripts/agent-reconnect-smoke.cjs",
    "agent:semantics-smoke": "node scripts/agent-semantics-smoke.cjs",
    "agent:shadow-smoke": "node scripts/agent-shadow-smoke.cjs",
    "bench:bun-webview": "bun scripts/bun-webview-bench.ts",
    "bench:electron-offscreen": "electron scripts/electron-offscreen-bench.cjs",
    "build": "tsc -p tsconfig.json",
    "build:engine": "pnpm --filter pixel-react build",
    "start": "pnpm build:engine && pnpm build && LOGS=\"${XDG_STATE_HOME:-$HOME/.local/state}/pixel/logs\" && mkdir -p \"$LOGS\" && exec electron dist/main.js 2>>\"$LOGS/stderr.log\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "terminal-browser-agent": "workspace:*",
    "pixel-react": "workspace:*",
    "pixel-store": "workspace:*",
    "pixel-terminals": "workspace:*",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "electron": "43.1.1",
    "typescript": "^5.5.0"
  }
}
